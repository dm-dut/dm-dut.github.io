name = "online-papers-refresh"
main = "worker.js"
compatibility_date = "2026-08-01"

[vars]
GITHUB_OWNER = "dm-dut"
GITHUB_REPO = "dm-dut.github.io"
GITHUB_REF = "main"
GITHUB_WORKFLOW = "update-paper-monitor.yml"
ALLOWED_ORIGINS = "https://dm-dut.github.io"

# Add secrets with Wrangler; do NOT place them in this file:
#   npx wrangler secret put GITHUB_PAT
#   npx wrangler secret put REFRESH_PASSWORD
