# LOCAL V6 ID-FIRST
# Only Springer Nature requires an API key.
SPRINGER_API_KEY=

# Springer: first run uses --initial-days 7; routine runs overlap yesterday/today.
OVERLAP_DAYS=1
EXPORT_DAYS=365
SPRINGER_BATCH_PAGE_SIZE=20
SPRINGER_BATCH_MAX_PAGES_PER_DAY=5
HTTP_TIMEOUT=25
HTTP_RETRY_TOTAL=2
HTTP_RETRY_BACKOFF=0.40
REQUEST_PAUSE_SECONDS=0.10

# Browser list pages only: ScienceDirect + IEEE Xplore.
BROWSER_CHANNEL=msedge
BROWSER_HEADLESS=false
BROWSER_NAV_TIMEOUT_MS=45000
BROWSER_WAIT_MS=1200
BROWSER_JOURNAL_DELAY_MS=250
BROWSER_MAX_RESULTS=50
BROWSER_KNOWN_STREAK_STOP=5
# BROWSER_PROFILE_DIR=paper_monitor_system/browser_profile

ENABLE_SCIENCEDIRECT=true
ENABLE_SPRINGER=true
ENABLE_IEEE=true
