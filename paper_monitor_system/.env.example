# Copy to paper_monitor_system/.env and fill in your own values.
# NEVER commit .env. The package's .gitignore excludes it.

SPRINGER_API_KEY=
CROSSREF_MAILTO=

# Optional / currently not required by LOCAL V3.3
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
IEEE_API_KEY=

# The combined IEEETrans15 Saved Search RSS is stored in journal_list.xlsx.
# Leave empty unless you want to override the workbook locally.
IEEE_SAVED_SEARCH_RSS_URL=

ENABLE_SCIENCEDIRECT=true
ENABLE_SPRINGER=true
ENABLE_IEEE=true

# ScienceDirect API/page are disabled because the user's local connectivity test
# returned 401/403. Elsevier discovery uses Crossref member batch instead.
ENABLE_SCIENCEDIRECT_API=false
ENABLE_SCIENCEDIRECT_PAGE=false
ENABLE_SCIENCEDIRECT_RSS=true

ENABLE_SPRINGER_API=true
ENABLE_SPRINGER_BATCH_API=true
ENABLE_IEEE_API=false
ENABLE_IEEE_CROSSREF_SUPPLEMENT=false
ENABLE_CROSSREF_FALLBACK=true
ENABLE_ELSEVIER_EMERGENCY_ISSN_FALLBACK=false

# Daily update: yesterday..today (two calendar dates, inclusive)
OVERLAP_DAYS=1
CROSSREF_DISCOVERY_DAYS=2

# Pending DOIs are rechecked by DOI only, roughly once per day.
PENDING_RECHECK_DAYS=60
PENDING_RECHECK_MIN_HOURS=20
PENDING_RECHECK_LIMIT=200

EXPORT_DAYS=365
EXPORT_LIMIT=20000

# Fast but conservative network settings
HTTP_TIMEOUT=20
HTTP_RETRY_TOTAL=2
HTTP_RETRY_BACKOFF=0.40
REQUEST_PAUSE_SECONDS=0.10

# Elsevier Crossref dual batch: published-online + generic publication-date, member 78; no hard prefix filter
ELSEVIER_CROSSREF_MEMBER_ID=78
CROSSREF_BATCH_ROWS=1000
CROSSREF_BATCH_MAX_PAGES=30

# Springer batch Meta API
SPRINGER_BATCH_PAGE_SIZE=20
SPRINGER_BATCH_MAX_PAGES=5

# V3.3: IEEE page requests are optional; RSS + Crossref title matching is the default fast path.
ENABLE_IEEE_PAGE_ENRICHMENT=false
IEEE_TITLE_MATCH_THRESHOLD=0.86
IEEE_TITLE_MATCH_ROWS=5
ENABLE_ELSEVIER_GENERIC_PUBDATE_FALLBACK=true
