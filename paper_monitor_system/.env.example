# Local use only. On GitHub, put these three values in Repository Secrets.
ELSEVIER_API_KEY=
SPRINGER_API_KEY=
IEEE_API_KEY=

# Optional but recommended for Crossref fallback polite-pool identification.
CROSSREF_MAILTO=

ENABLE_CROSSREF_FALLBACK=true
OVERLAP_DAYS=3
EXPORT_DAYS=365
HTTP_TIMEOUT=45
REQUEST_PAUSE_SECONDS=0.60
