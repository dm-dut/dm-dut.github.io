# API keys -- never commit real keys
ELSEVIER_API_KEY=
SPRINGER_API_KEY=
IEEE_API_KEY=

# Default: local SQLite. Can later be changed to PostgreSQL, e.g.
# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///data/papers.db

# Number of days deliberately re-fetched on every run to catch delayed indexing.
OVERLAP_DAYS=3

# Export only recent records to the static website JSON.
EXPORT_DAYS=365
EXPORT_LIMIT=20000

# Request behavior
HTTP_TIMEOUT=45
REQUEST_PAUSE_SECONDS=0.15

# Optional: if IEEE installation requires querytext, set it here.
# Usually insertion-date filtering is enough.
IEEE_QUERYTEXT=

# Optional publisher switches
ENABLE_SCIENCEDIRECT=true
ENABLE_SPRINGER=true
ENABLE_IEEE=true

# Journal whitelist. Only Enabled=1 rows are fetched and exported.
JOURNAL_LIST_PATH=journal_list.xlsx
WHITELIST_REQUIRED=true
