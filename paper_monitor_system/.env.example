# Springer Meta API remains the authoritative primary Springer source.
SPRINGER_API_KEY=

# Optional Crossref polite-pool contact.
CROSSREF_MAILTO=

# Elsevier and IEEE publisher APIs are deliberately disabled in this hybrid build.
ENABLE_SCIENCEDIRECT_API=false
ENABLE_SPRINGER_API=true
ENABLE_IEEE_API=false
ENABLE_CROSSREF_FALLBACK=true

# Optional override. Normally the combined IEEE Saved Search RSS is read from
# paper_monitor_system/journal_list.xlsx, so this can remain blank.
IEEE_SAVED_SEARCH_RSS_URL=

OVERLAP_DAYS=3
EXPORT_DAYS=365
