# LOCAL V4 is Crossref-only. No Elsevier/Springer/IEEE API keys are required.
CROSSREF_MAILTO=your-email@example.com
CROSSREF_DISCOVERY_DAYS=2
OVERLAP_DAYS=1
CROSSREF_ROWS=1000
CROSSREF_MAX_PAGES=30
HTTP_TIMEOUT=20
HTTP_RETRY_TOTAL=2
HTTP_RETRY_BACKOFF=0.5
REQUEST_PAUSE_SECONDS=0.05
EXPORT_DAYS=365
EXPORT_LIMIT=20000
