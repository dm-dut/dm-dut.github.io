# Local use only. On GitHub, put API credentials in Repository Secrets.
ELSEVIER_API_KEY=
# Optional: institution token if Elsevier grants one for off-campus/server access.
ELSEVIER_INSTTOKEN=
SPRINGER_API_KEY=
IEEE_API_KEY=

# Optional but recommended for Crossref polite-pool identification.
CROSSREF_MAILTO=

ENABLE_CROSSREF_FALLBACK=true
CROSSREF_DISCOVERY_DAYS=30
OVERLAP_DAYS=3
EXPORT_DAYS=365
HTTP_TIMEOUT=45
REQUEST_PAUSE_SECONDS=0.60
