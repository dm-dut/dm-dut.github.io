# Copy this file to paper_monitor_system/.env and fill in your own values.
# NEVER commit .env. The package's .gitignore excludes it.

SPRINGER_API_KEY=
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
IEEE_API_KEY=
CROSSREF_MAILTO=

# The combined IEEETrans15 Saved Search RSS is already stored in journal_list.xlsx.
# Leave this empty unless you want to override that workbook value locally.
IEEE_SAVED_SEARCH_RSS_URL=

# LOCAL V2 provider switches
ENABLE_SCIENCEDIRECT=true
ENABLE_SPRINGER=true
ENABLE_IEEE=true

# Your real local test returned ScienceDirect API 401 and page 403, so these
# two optional paths are disabled by default. Crossref incremental remains active.
ENABLE_SCIENCEDIRECT_API=false
ENABLE_SCIENCEDIRECT_PAGE=false
ENABLE_SCIENCEDIRECT_RSS=true

ENABLE_SPRINGER_API=true
ENABLE_SPRINGER_BATCH_API=true
ENABLE_IEEE_API=false
ENABLE_CROSSREF_FALLBACK=true

OVERLAP_DAYS=3
EXPORT_DAYS=365
CROSSREF_DISCOVERY_DAYS=30
PENDING_RECHECK_DAYS=60
REQUEST_PAUSE_SECONDS=0.35
HTTP_TIMEOUT=45
SPRINGER_BATCH_PAGE_SIZE=20
SPRINGER_BATCH_MAX_PAGES=250
